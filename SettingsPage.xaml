<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileViewerDemo.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileViewerDemo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 这里是文件浏览器演示程序的设置页面 -->
    <ScrollViewer>
        <StackPanel Spacing="20" Padding="24">

            <StackPanel Spacing="8">
                <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                <RadioButtons Header="应用主题" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <x:String>浅色</x:String>
                    <x:String>深色</x:String>
                    <x:String>跟随系统</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="文件浏览" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch Header="显示隐藏文件" IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}" />
                <ToggleSwitch Header="显示文件扩展名" IsOn="{x:Bind ViewModel.ShowFileExtensions, Mode=TwoWay}" />
            </StackPanel>
            
            <StackPanel Spacing="8">
                <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="FileViewerDemo v1.0.0" />
                <TextBlock Text="基于 WinUI 3 构建的轻量级文件浏览器。" Opacity="0.7" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
